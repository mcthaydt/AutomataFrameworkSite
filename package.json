{
  "name": "@automataframework/site",
  "version": "0.0.0",
  "private": true,
  "description": "The AutomataFramework website: one page with the demo game playing.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.21.0"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p .",
    "knip": "knip",
    "build": "vite build && node scripts/add-game.ts && node scripts/take-pictures.ts",
    "test:node": "vitest run",
    "test:journeys": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "knip": "6.39.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "4.140.0"
  }
}
